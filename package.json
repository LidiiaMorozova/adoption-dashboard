{
  "name": "adoption-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run start:dev",
    "build": "vue-tsc --build && vite build",
    "build:demo": "vue-tsc --build && vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo --port 4173",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "chart.js": "^4.6.1",
    "d3": "^7.9.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.18",
    "@tsconfig/node22": "^22.0.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^9.33.0",
    "tailwindcss": "4.1.18",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vue-tsc": "^2.2.12"
  }
}
